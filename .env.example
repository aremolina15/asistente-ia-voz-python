# Variables de entorno para DevOps Voice Assistant

# GCP Configuration
# IMPORTANTE: Reemplaza con tu propio proyecto GCP
GOOGLE_CLOUD_PROJECT=tu-proyecto-gcp
GCP_REGION=us-central1

# Application Settings
DEBUG=False
LOG_LEVEL=INFO
# IMPORTANTE: Cambia este valor en producción con una clave segura
SECRET_KEY=tu-clave-secreta-aqui-cambia-en-produccion

# CORS Settings
# En producción, especifica los orígenes permitidos separados por comas
# Ejemplo: ALLOWED_ORIGINS=https://tudominio.com,https://app.tudominio.com
ALLOWED_ORIGINS=*

# API Configuration
API_TITLE=DevOps Voice Assistant API
API_VERSION=v1

# Storage Configuration
STORAGE_BUCKET=devops-assistant-storage

# VertexAI Configuration
VERTEX_AI_MODEL=gemini-2.0-flash
VERTEX_AI_TEMPERATURE=0.7
VERTEX_AI_MAX_TOKENS=1024

# RAG Configuration
RAG_ENABLED=false
RAG_TOP_K=5
RAG_COLLECTION_NAME=devops_knowledge
RAG_DB_PATH=data/chroma
RAG_KNOWLEDGE_DIR=data/knowledge
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_EMBEDDING_MODEL=text-embedding-005
RAG_STRICT_MODE=true
RAG_MIN_LEXICAL_OVERLAP=0.30
RAG_VECTOR_WEIGHT=0.20
RAG_LEXICAL_WEIGHT=0.80

# Database (opcional)
DATABASE_URL=

# Redis (opcional)
REDIS_URL=

# Voice Settings
SPEECH_TO_TEXT_ENABLED=true
TEXT_TO_SPEECH_ENABLED=true
VOICE_DEFAULT_LANGUAGE_CODE=es-CO
VOICE_TTS_NAME=
VOICE_TTS_GENDER=FEMALE
VOICE_TTS_SPEAKING_RATE=1.0
VOICE_TTS_PITCH=0.0
